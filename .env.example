# Get a key at https://aistudio.google.com/apikey  (billing must be enabled for production)
GEMINI_API_KEY=your-key-here

# Optional overrides (sensible defaults live in config.py)
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001
STORE_DISPLAY_NAME=support-kb

# After the first `python kb_sync.py`, copy the store name it prints into here so
# the server pins to the same store:
# FILE_SEARCH_STORE_NAME=fileSearchStores/xxxxxxxx

# Comma-separated front-end domains allowed to call the backend:
ALLOWED_ORIGINS=https://app.clearimpact.com,https://app.compyle.com
